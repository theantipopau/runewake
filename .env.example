# RuneWake repository environment template
#
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Used by: Makefile (database maintenance helpers), docker-compose.yml
# (MariaDB container), and the RuneWake server when exported by a process
# manager or shell.
#
# The Java server does not read this file automatically. Export these variables
# in the service environment (or source the file before starting Ant) when you
# want them to override server/connections.conf.

# RuneWake server database settings. Leave DB_TYPE=sqlite for a local,
# zero-service setup. For a hosted MariaDB/MySQL database use:
#   DB_TYPE=mysql
#   DB_HOST=127.0.0.1:3306
#   DB_NAME=runewake
#   DB_USER=runewake
#   DB_PASS=<a secret>
#   DB_SSL_MODE=VERIFY_IDENTITY
DB_TYPE=sqlite
DB_HOST=127.0.0.1:3306
DB_NAME=preservation
DB_USER=
DB_PASS=
DB_TABLE_PREFIX=
DB_SSL_MODE=PREFERRED
DB_CONNECT_TIMEOUT=10000

# Local/private MariaDB container settings. The container creates the game's
# application account from MARIADB_USER/MARIADB_PASSWORD and the
# administrative account from MARIADB_ROOT_PASSWORD. It does not read
# MARIADB_ROOT_USER (that knob belongs to the Bitnami image); the root host
# pattern is MARIADB_ROOT_HOST, which defaults to % so the legacy `make` targets
# can reach root over the loopback-published port. Set it to localhost to keep
# root on the container's own socket. Never point the game server at root.
MARIADB_DATABASE=runewake
MARIADB_ROOT_PASSWORD=
MARIADB_ROOT_HOST=%
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_BIND_ADDRESS=127.0.0.1
MARIADB_HOST_PORT=3306

# Administrative account used by the legacy `make *-mariadb` maintenance
# targets (create, import, rank, namechange, purge, backup). Those targets run
# through scripts/mysql_client.sh, so the password is never passed as a command
# argument. Set MYSQL_USER/MYSQL_PASSWORD to use a dedicated account instead;
# MYSQL_* wins over the MARIADB_ROOT_* fallback.
MARIADB_ROOT_USER=root

# Where database dumps are written (Makefile backup targets).
MYSQL_DUMPS_DIR=./backups

# Discord webhook used by the Makefile purge-old-logs notification
# (treat as a secret: anyone with the URL can post to the channel).
TERMINAL_WEBHOOK=
