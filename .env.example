# RuneWake repository environment template
#
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Used by: Makefile (db backup/rank/namechange helpers), docker-compose.yml
# (MariaDB container).

# MariaDB root credentials (docker-compose + Makefile)
MARIADB_ROOT_USER=
MARIADB_ROOT_PASSWORD=

# Application database user (docker-compose)
MARIADB_USER=
MARIADB_PASS=

# Where database dumps are written (Makefile backup targets)
MYSQL_DUMPS_DIR=

# Discord webhook used by the Makefile purge-old-logs notification
# (treat as a secret: anyone with the URL can post to the channel)
TERMINAL_WEBHOOK=
