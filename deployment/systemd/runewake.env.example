# Install as /etc/runewake/runewake.env and replace every placeholder.
# Keep this file mode 0600; it is read by the RuneWake service, not committed.
#
# A local MariaDB on the same VM can use:
#   DB_SSL_MODE=PREFERRED
# A remote database should normally use certificate verification:
#   DB_SSL_MODE=VERIFY_IDENTITY
DB_TYPE=mysql
DB_HOST=127.0.0.1:3306
DB_NAME=runewake
DB_USER=runewake
DB_PASS=
DB_TABLE_PREFIX=
DB_SSL_MODE=PREFERRED
DB_CONNECT_TIMEOUT=10000
